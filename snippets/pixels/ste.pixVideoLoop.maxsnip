                                            },
                                            {
                                                "box": {
                                                    "format": 6,
                                                    "id": "obj-10",
                                                    "maxclass": "flonum",
                                                    "numinlets": 1,
                                                    "numoutlets": 2,
                                                    "outlettype": [ "", "bang" ],
                                                    "parameter_enable": 0,
                                                    "patching_rect": [ 189.0, 474.0, 50.0, 22.0 ]
                                                }
                                            },
                                            {
                                                "box": {
                                                    "id": "obj-8",
                                                    "linecount": 4,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 6.0, 532.0, 173.0, 60.0 ],
                                                    "text": "you can change preset from outside by sending in the first inlet the preset number (int or float) with a prepend \"preset\" "
                                                }
                                            },
                                            {
                                                "box": {
                                                    "id": "obj-3",
                                                    "linecount": 29,
                                                    "maxclass": "comment",
                                                    "numinlets": 1,
                                                    "numoutlets": 0,
                                                    "patching_rect": [ 6.0, 45.0, 317.0, 395.0 ],
                                                    "text": "video player with speed and volume control.\nsound plays thru computer default output (not thru max)\ndefine looppoints in milliseconds and the type of loop if normal or palindrom\n\npalindrom \ndoes not work when continuously modulating the speed externally\n\nloadram \nloads 1st and last second of the video in the ram\nit helps with non hap videos that might hiccup at loop, but\nit can flash a little frame glitch after loading the file\n\nresetLoopAfterLoad \ndecides if after loading a new file the looppoints reset, which is generally usefull when trying out different videos, but can be unwanted when using preset changes and loading video that has specific looppoints to be set via preset or ste.scenes\n\nwirelessAudioOut \nwirelessly sends the video's sound to the ste.audioOut~, if you want to process the audio in your patch you might want to turn this off\n\nposOut \nwhen ON: the snippets outputs the movie position as 0.-1. number, from the 5th output"
                                                }
                                            },
